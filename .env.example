# Django secret key
SECRET_KEY=your-secret-key-here

# Debug mode (False for production, True for local dev)
DEBUG=False

# Allowed hosts (comma-separated, e.g. .onrender.com,localhost)
ALLOWED_HOSTS=*

# NumVerify API Key for VoIP Phone Intelligence
NUMVERIFY_API_KEY=your_numverify_api_key

# Optional: Database URL (Render attaches this automatically when using Render PostgreSQL)
# DATABASE_URL=postgres://user:password@hostname:5432/dbname
